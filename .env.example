# ---------------------------------------------------------------------------
# Tea Factory — frontend configuration
# Copy to .env when the API is not on the machine serving this app.
# ---------------------------------------------------------------------------

# Where the backend lives, with no trailing slash. The client appends /api.
#
# Leave unset in normal development: the app works out the host from wherever
# Expo served the bundle, which covers web, both simulators, and a phone on the
# same wifi. Set it explicitly for a deployed API, or if the backend runs on a
# different machine or port than the Expo dev server.
#
#   EXPO_PUBLIC_API_URL=http://192.168.1.14:4000
#   EXPO_PUBLIC_API_URL=https://api.example.com
